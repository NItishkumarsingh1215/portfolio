    <style>
        :root {
            --bg: #f8f7f2;
            --surface: #ffffff;
            --text: #252720;
            --muted: #70736c;
            --accent: #536b50;
            --border: #e4e3dc;
            --soft: #eeefe8;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        .container {
            width: min(1050px, 88%);
            margin: auto;
        }

        /* Navigation */

        header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(248, 247, 242, 0.95);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(12px);
        }

        nav {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .logo {
            font-size: 17px;
            font-weight: 750;
            letter-spacing: -0.5px;
            white-space: nowrap;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 26px;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: var(--muted);
            font-size: 13px;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--accent);
        }

        /* Common sections */

        section {
            padding: 82px 0;
            border-bottom: 1px solid var(--border);
        }

        .section-label {
            display: block;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        h1, h2, h3 {
            line-height: 1.25;
            letter-spacing: -0.7px;
        }

        h2 {
            font-size: clamp(26px, 4vw, 34px);
            margin-bottom: 28px;
        }

        h3 {
            font-size: 19px;
            margin-bottom: 12px;
        }

        .muted {
            color: var(--muted);
        }

        /* Hero */

        .hero {
            padding: 110px 0 90px;
            border-bottom: 1px solid var(--border);
        }

        .hero-tag {
            display: inline-block;
            background: var(--soft);
            color: var(--accent);
            border-radius: 30px;
            padding: 7px 14px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .hero h1 {
            font-size: clamp(40px, 7vw, 68px);
            max-width: 800px;
            line-height: 1.08;
            margin-bottom: 18px;
        }

        .hero h1 span {
            color: var(--accent);
        }

        .hero-subtitle {
            font-size: clamp(17px, 2.5vw, 21px);
            color: var(--muted);
            margin-bottom: 18px;
        }

        .hero-description {
            max-width: 650px;
            color: var(--muted);
            margin-bottom: 30px;
        }

        .button-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            padding: 12px 19px;
            border: 1px solid var(--accent);
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.2s;
        }

        .button-primary {
            background: var(--accent);
            color: white;
        }

        .button-primary:hover {
            background: #40553e;
        }

        .button-secondary:hover {
            background: var(--soft);
        }

        /* About */

        .about-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 45px;
            align-items: start;
        }

        .about-copy p {
            color: var(--muted);
            margin-bottom: 16px;
        }

        .info-card {
            padding: 24px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--surface);
        }

        .info-item {
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-item small {
            display: block;
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .info-item strong {
            font-size: 14px;
        }

        /* Skills */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .skill-card {
            padding: 23px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .skill-card h3 {
            font-size: 16px;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag {
            display: inline-block;
            background: var(--soft);
            border-radius: 5px;
            padding: 6px 10px;
            font-size: 12px;
            color: #43483f;
        }

        /* Projects */

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .project-card {
            display: flex;
            flex-direction: column;
            padding: 26px;
            border: 1px solid var(--border);
            background: var(--surface);
            border-radius: 12px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .project-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(30, 35, 25, 0.06);
        }

        .project-number {
            font-size: 12px;
            color: var(--accent);
            font-weight: 700;
            letter-spacing: 1.5px;
            margin-bottom: 16px;
        }

        .project-card p {
            font-size: 14px;
            color: var(--muted);
            margin-bottom: 17px;
        }

        .project-card ul {
            padding-left: 19px;
            margin-bottom: 22px;
            color: var(--muted);
            font-size: 13px;
        }

        .project-card li {
            margin-bottom: 7px;
        }

        .project-card .tags {
            margin-top: auto;
            margin-bottom: 20px;
        }

        .project-link {
            font-size: 13px;
            font-weight: 700;
            color: var(--accent);
        }

        .achievement {
            display: inline-block;
            align-self: flex-start;
            margin-bottom: 14px;
            padding: 5px 9px;
            background: var(--soft);
            border-radius: 5px;
            color: var(--accent);
            font-size: 11px;
            font-weight: 700;
        }

        /* Education */

        .education-card {
            padding: 27px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            max-width: 750px;
        }

        .education-date {
            font-size: 13px;
            color: var(--accent);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .education-card p {
            color: var(--muted);
            font-size: 14px;
        }

        /* Certificates */

        .certificate-list {
            display: grid;
            gap: 12px;
            max-width: 800px;
        }

        .certificate-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 18px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 9px;
        }

        .certificate-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            background: var(--soft);
            color: var(--accent);
            border-radius: 8px;
            font-weight: bold;
        }

        .certificate-item h3 {
            font-size: 15px;
            margin-bottom: 4px;
        }

        .certificate-item p {
            font-size: 13px;
            color: var(--muted);
        }

        /* Contact */

        .contact-box {
            padding: 35px;
            background: var(--soft);
            border-radius: 14px;
        }

        .contact-box > p {
            color: var(--muted);
            max-width: 620px;
            margin-bottom: 24px;
        }

        .contact-links {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .contact-links a {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 7px;
            padding: 10px 14px;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .contact-links a:hover {
            border-color: var(--accent);
        }

        /* Footer */

        footer {
            padding: 26px 0;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
            font-size: 12px;
            color: var(--muted);
        }

        /* Responsive */

        @media (max-width: 700px) {
            nav {
                padding: 14px 0;
                align-items: flex-start;
                flex-direction: column;
                gap: 12px;
            }

            .nav-links {
                gap: 16px;
            }

            .nav-links a {
                font-size: 12px;
            }

            section {
                padding: 60px 0;
            }

            .hero {
                padding: 75px 0 65px;
            }

            .about-grid,
            .skills-grid,
            .projects-grid {
                grid-template-columns: 1fr;
            }

            .about-grid {
                gap: 25px;
            }

            .project-card,
            .skill-card {
                padding: 21px;
            }

            .contact-box {
                padding: 24px;
            }
        }
    </style>
</head>

